{
  "name": "voice-typer",
  "version": "1.0.0",
  "description": "系统级语音输入工具 - 快捷键说话，自动转文字上屏",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.voicetyper.app",
    "productName": "语音输入",
    "directories": {
      "output": "release"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.17.0",
    "electron": "^42.3.3",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "electron-packager": "^17.1.2"
  }
}
